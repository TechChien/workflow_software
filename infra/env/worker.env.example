CODEX_TURN_TIMEOUT_MS=1800000
CODE_WORKSPACE_REPO_PATH=..
ARTIFACT_STORE_ROOT=../data/artifacts
CODE_WORKTREE_ROOT=../data/worktrees
EXPORT_ROOT=../data/exports
WORKER_POLL_INTERVAL_MS=5000
WORKER_POLLING_ENABLED=true
