HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://workflow:workflow@localhost:5432/workflow_software
AGENT_EXECUTOR=claude
AGENT_EVALUATOR=claude
AGENT_TURN_TIMEOUT_MS=1800000
