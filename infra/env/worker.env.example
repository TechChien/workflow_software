# CLAUDE_EFFORT=high
CLAUDE_PERMISSION_MODE=acceptEdits
# CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,MultiEdit,Glob,Grep,Bash
# CLAUDE_DISALLOWED_TOOLS=WebFetch,WebSearch
# CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=true
