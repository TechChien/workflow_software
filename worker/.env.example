# Worker API
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://workflow:workflow@localhost:5432/workflow_software
WORKER_POLL_INTERVAL_MS=5000
WORKER_POLLING_ENABLED=true

# Agent selection: claude or codex
AGENT_EXECUTOR=claude
AGENT_EVALUATOR=claude
AGENT_TURN_TIMEOUT_MS=1800000

# Claude / Anthropic
# ANTHROPIC_API_KEY=replace-with-an-api-key
# ANTHROPIC_AUTH_TOKEN=replace-with-an-auth-token
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_CUSTOM_HEADERS=header=value
# CLAUDE_MODEL=replace-with-a-claude-model
# CLAUDE_EFFORT=high
CLAUDE_PERMISSION_MODE=acceptEdits
# CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,MultiEdit,Glob,Grep,Bash
# CLAUDE_DISALLOWED_TOOLS=WebFetch,WebSearch
# CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=true
# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=true
# CLAUDE_CODE_DISABLE_THINKING=true
# CLAUDE_CODE_ALWAYS_ENABLE_EFFORT=true
# API_TIMEOUT_MS=600000

# Codex / OpenAI
# CODEX_API_KEY=replace-with-an-api-key
# CODEX_BASE_URL=https://api.openai.com/v1
# CODEX_MODEL=replace-with-a-codex-model
# CODEX_REASONING_EFFORT=high
CODEX_TURN_TIMEOUT_MS=1800000

# Local paths are resolved from the worker directory.
CODE_WORKSPACE_REPO_PATH=..
ARTIFACT_STORE_ROOT=../data/artifacts
CODE_WORKTREE_ROOT=../data/worktrees
EXPORT_ROOT=../data/exports

# Optional integration test flags
# RUN_CLAUDE_AGENT_INTEGRATION=true
# CLAUDE_AGENT_INTEGRATION_TIMEOUT_MS=180000
# RUN_CLAUDE_DB_INTEGRATION=true
# CLAUDE_DB_INTEGRATION_TIMEOUT_MS=180000
# RUN_CODEX_DB_INTEGRATION=true
# CODEX_DB_INTEGRATION_TIMEOUT_MS=180000
# RUN_WORKSPACE_INTEGRATION=true
# WORKSPACE_INTEGRATION_TIMEOUT_MS=180000
# WORKSPACE_INTEGRATION_REPO_PATH=..
# WORKSPACE_INTEGRATION_WORKTREE_ROOT=../data/worktrees/integration
# WORKSPACE_INTEGRATION_BASE_REF=HEAD
