{
  "name": "@workflow-software/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @workflow-software/shared build && tsx watch src/index.ts",
    "cli": "pnpm --filter @workflow-software/shared build && tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @workflow-software/shared build && tsc --noEmit -p tsconfig.json",
    "test": "tsc -p ../shared/tsconfig.json && vitest run",
    "test:watch": "tsc -p ../shared/tsconfig.json && vitest",
    "codex:smoke": "tsx src/codex/smoke.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.136.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "latest",
    "@workflow-software/shared": "workspace:*",
    "fastify": "latest",
    "pg": "^8.21.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "prisma": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "3.2.4"
  }
}
